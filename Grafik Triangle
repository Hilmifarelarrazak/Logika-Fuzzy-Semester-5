import numpy as np
import matplotlib.pyplot as plt

# =========================================================
# FUNGSI KEANGGOTAAN SEGITIGA
# =========================================================

def fungsi_segitiga(x, a, b, c, tinggi):
    y = np.zeros_like(x, dtype=float)

    # Sisi kiri
    kondisi_kiri = (x >= a) & (x <= b)
    y[kondisi_kiri] = (
        (x[kondisi_kiri] - a) / (b - a)
    ) * tinggi

    # Sisi kanan
    kondisi_kanan = (x >= b) & (x <= c)
    y[kondisi_kanan] = (
        (c - x[kondisi_kanan]) / (c - b)
    ) * tinggi

    return y


# =========================================================
# 1. BAYI / ANAK USIA DINI
# μ = 0,5
# =========================================================

x = np.linspace(0, 6, 500)

a = 0
b = 2.5
c = 5
mu = 0.5

y = fungsi_segitiga(x, a, b, c, mu)

plt.figure(figsize=(9, 5))

plt.plot(
    x, y,
    linewidth=2,
    label='Bayi/Anak Usia Dini'
)

# GARIS TENGAH
plt.vlines(
    b,
    0,
    mu,
    linestyle='--',
    linewidth=2
)

# TITIK PUNCAK
plt.scatter(b, mu, s=50, zorder=5)

# LABEL μ
plt.text(
    b + 0.15,
    mu,
    'μ = 0,5',
    fontsize=11,
    va='center'
)

plt.title(
    'Grafik Fungsi Keanggotaan Bayi/Anak Usia Dini'
)

plt.xlabel('Usia (tahun)')
plt.ylabel('Derajat Keanggotaan μ(x)')

plt.xlim(0, 6)
plt.ylim(0, 0.55)

plt.xticks(np.arange(0, 6, 1))
plt.yticks(np.arange(0, 0.6, 0.1))

plt.grid(True, linestyle='--', alpha=0.5)
plt.legend()

plt.tight_layout()
plt.show()


